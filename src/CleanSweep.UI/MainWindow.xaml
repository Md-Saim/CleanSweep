<Window x:Class="CleanSweep.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CleanSweep.UI"
        xmlns:viewmodels="clr-namespace:CleanSweep.UI.ViewModels"
        xmlns:analyzer="clr-namespace:CleanSweep.Core.Analyzer;assembly=CleanSweep.Core"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Icon="/Assets/logo.png"
        Title="CleanSweep" Height="800" Width="1050" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="InverseBoolVis" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCleaning}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- System Tray Icon — custom styles fix the black gutter bug -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/logo.ico"
                        ToolTipText="CleanSweep is running in background"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource TrayContextMenu}">
                    <MenuItem Header="  ✨  Show CleanSweep" Click="MenuShow_Click" Style="{StaticResource TrayMenuItem}"/>
                    <MenuItem Header="  🧹  Clean Files" Click="MenuClean_Click" Style="{StaticResource TrayMenuItem}"/>
                    <Separator Style="{StaticResource TraySeparator}"/>
                    <MenuItem Header="  ✕   Quit" Click="MenuQuit_Click" Style="{StaticResource TrayMenuItem}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Main Content Layer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                
                <!-- ═══════════════════════════════════════════ -->
                <!-- HEADER & DASHBOARD SECTION -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="System Cleaner" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Settings Gear Button -->
                    <Button x:Name="BtnSettings" Style="{StaticResource SettingsButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnSettings_Click"/>
                </Grid>

                <Border Style="{StaticResource DarkCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="32" Margin="0,0,10,0" Foreground="{StaticResource AccentMintBrush}"/>
                                <TextBlock Text="CLEANSWEAP DASH" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CleanStatus}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkboxes Left -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource MintCheckBox}" IsChecked="{Binding CleanTemp}">
                                    <StackPanel>
                                        <TextBlock Text="Temporary Files" FontWeight="SemiBold"/>
                                        <TextBlock Text="(%TEMP%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource MintCheckBox}" IsChecked="{Binding CleanPrefetch}">
                                    <StackPanel>
                                        <TextBlock Text="Prefetch Files" FontWeight="SemiBold"/>
                                        <TextBlock Text="(Windows Prefetch cache)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource MintCheckBox}" IsChecked="{Binding CleanRecycleBin}">
                                    <StackPanel>
                                        <TextBlock Text="Recycle Bin" FontWeight="SemiBold"/>
                                        <TextBlock Text="(All items in Recycle Bin)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- Big Button Center -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                                    <Run Text="Total estimated: "/>
                                    <Run Text="{Binding TotalEstimated, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </TextBlock>
                                <Button Command="{Binding ScanAndCleanCommand}" IsEnabled="{Binding IsCleaning, Converter={x:Static local:InverseBoolConverter.Instance}}" Style="{StaticResource LiquidGlassButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧹" Margin="0,0,10,0"/>
                                        <TextBlock Text="SCAN &amp; CLEAN" Foreground="{StaticResource BgDeepBrush}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="⚠ This operation requires administrator privileges." FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>

                            <!-- Estimated Sizes Right -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TempSize}" Foreground="{StaticResource AccentMintBrush}" FontWeight="SemiBold" Margin="0,8,0,24" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding PrefetchSize}" Foreground="{StaticResource AccentMintBrush}" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding RecycleBinSize}" Foreground="{StaticResource AccentMintBrush}" FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Progress Bar -->
                        <ProgressBar Grid.Row="2" Value="{Binding CleanProgress}" Maximum="100" Height="4" Background="Transparent" Foreground="{StaticResource AccentMintBrush}" BorderThickness="0" Margin="0,20,0,0" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- SYSTEM PERFORMANCE CARDS -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DarkCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🖥️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="CPU Usage" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding CpuUsage, StringFormat={}{0:F0}}"/><Run Text="%" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CpuTemp}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" 🌡️" FontSize="16" Margin="4,0,0,0" Foreground="{StaticResource AccentMintBrush}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Value="{Binding CpuUsage}" Style="{StaticResource AccentProgressBar}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DarkCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="RAM Usage" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding RamUsedText}"/>
                                        <Run Text=" / " Foreground="{StaticResource TextMutedBrush}"/>
                                        <Run Text="{Binding RamTotalText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding RamPercentText}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding RamFreeText}"/>
                                    </TextBlock>
                                    <TextBlock Text="Free" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Value="{Binding RamPercent}" Style="{StaticResource AccentProgressBar}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource DarkCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🎮" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="GPU Usage" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding GpuUsage, StringFormat={}{0:F0}}"/><Run Text="%" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GpuTemp}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" 🌡️" FontSize="16" Margin="4,0,0,0" Foreground="{StaticResource AccentMintBrush}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Value="{Binding GpuUsage}" Style="{StaticResource AccentProgressBar}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- DRIVES SECTION -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource DarkCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💿" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="DRIVE STATUS" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DiskScanStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Drive" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Used" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Free" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Total" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="20,0,10,0"/>
                            <TextBlock Grid.Column="5" Text="Usage" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,0,4"/>

                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Padding="8,10" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Drive_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="🖴" FontSize="18" Foreground="{StaticResource AccentMintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding UsedText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FreeText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>

                                                <Grid Grid.Column="4" Margin="20,0,10,0" VerticalAlignment="Center">
                                                    <Border Background="#262A33" CornerRadius="3" Height="8"/>
                                                    <Border CornerRadius="3" Height="8" HorizontalAlignment="Left" Background="{StaticResource AccentMintBrush}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{x:Static local:PercentToWidthConverter.Instance}">
                                                                <Binding Path="UsagePercent"/>
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Column="5" Text="{Binding UsagePercentText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Background="#16191E" Margin="30,0,0,8" Padding="12" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AnalyzerStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                                <TreeView ItemsSource="{Binding AnalyzerNodes}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" MaxHeight="400">
                                                    <TreeView.Resources>
                                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#262A33"/>
                                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#262A33"/>
                                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6EDF3"/>
                                                    </TreeView.Resources>
                                                    <TreeView.ItemTemplate>
                                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="📄"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                                    <Setter Property="Text" Value="📁"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                            </Grid>
                                                        </HierarchicalDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                    <TreeView.ItemContainerStyle>
                                                        <Style TargetType="TreeViewItem">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                            <Setter Property="Padding" Value="2"/>
                                                        </Style>
                                                    </TreeView.ItemContainerStyle>
                                                </TreeView>
                                            </StackPanel>
                                        </Border>
                                        <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SETTINGS PANEL OVERLAY -->
        <!-- ═══════════════════════════════════════════ -->
        
        <!-- Backdrop (click to close) -->
        <Border x:Name="SettingsBackdrop" Background="#80000000" Visibility="Collapsed" MouseLeftButtonDown="SettingsBackdrop_Click">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Resources>
                        <Storyboard x:Key="FadeIn">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                    </Style.Resources>
                </Style>
            </Border.Style>
        </Border>

        <!-- Slide-in Panel from Right -->
        <Border x:Name="SettingsPanel" Width="380" HorizontalAlignment="Right" Background="#1A1D23" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsPanelTranslate" X="400"/>
            </Border.RenderTransform>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20">
                    
                    <!-- Panel Header -->
                    <Grid Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="20" Margin="0,0,10,0" Foreground="{StaticResource AccentMintBrush}"/>
                            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCloseSettings_Click"
                                FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="6,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBg" Property="Background" Value="#30363D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════ -->
                    <!-- ABOUT CLEANSWEAP -->
                    <!-- ═══════════════════════════════════════════ -->
                    <Border Background="#1D2128" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Image Source="/Assets/logo.png" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CleanSweap" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Version 1.0  •  Open Source" FontSize="11" Foreground="{StaticResource AccentMintBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#2C313B" Margin="0,4,0,12"/>

                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" LineHeight="20">
                                A powerful system cleaner for Windows. Scan, analyze, and reclaim disk space by cleaning temporary files, prefetch cache, and Recycle Bin.
                                <LineBreak/><LineBreak/>
                                Monitor real-time CPU, RAM, and GPU usage. Explore drive contents with the built-in disk analyzer to find what's consuming your storage.
                            </TextBlock>

                            <Rectangle Height="1" Fill="#2C313B" Margin="0,12,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="License" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="MIT" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Platform" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows 10/11" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════ -->
                    <!-- ABOUT THE DEVELOPER -->
                    <!-- ═══════════════════════════════════════════ -->
                    <Border Background="#1D2128" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DEVELOPER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#262A33" Margin="0,0,14,0">
                                    <TextBlock Text="MS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Md Saim" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="AI Engineer  •  Gen AI Expert" FontSize="12" Foreground="{StaticResource AccentMintBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#2C313B" Margin="0,0,0,12"/>

                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" LineHeight="20">
                                Specializing in AI automation, custom AI workflows, and intelligent system solutions. Building tools that leverage cutting-edge artificial intelligence to solve real-world problems.
                                <LineBreak/><LineBreak/>
                                Expert in designing end-to-end AI pipelines, autonomous agents, and production-grade generative AI systems.
                            </TextBlock>

                            <Rectangle Height="1" Fill="#2C313B" Margin="0,12,0,12"/>

                            <!-- GitHub Link -->
                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="GitHub_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#12FFFFFF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
