<Window x:Class="CleanSweep.WebInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSweep Setup" Height="500" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Icon="/Assets/logo.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" Padding="24,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="36" Height="36" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="Welcome to CleanSweep Setup" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="This wizard will guide you through the installation." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}" Padding="32,24">
            <Grid>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PAGE 1: Welcome / About -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel x:Name="Page1_Welcome" Visibility="Visible">
                <TextBlock Text="About CleanSweep" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentMintBrush}" Margin="0,0,0,12"/>
                
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" LineHeight="21" Margin="0,0,0,20">
                    CleanSweep is a powerful open-source system cleaner for Windows. It scans and removes temporary files, prefetch cache, and Recycle Bin contents to reclaim disk space and keep your system running smoothly.
                </TextBlock>

                <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="DEVELOPER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#262A33" Margin="0,0,12,0">
                                <TextBlock Text="MS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Md Saim" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="AI Engineer  •  Gen AI Expert" FontSize="11" Foreground="{StaticResource AccentMintBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,0" LineHeight="18">
                            Specializing in AI automation, custom AI workflows, and intelligent system solutions. Building tools that leverage cutting-edge artificial intelligence to solve real-world problems.
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink NavigateUri="https://github.com/Md-Saim" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentMintBrush}" TextDecorations="None">
                                <Run Text="🔗 github.com/Md-Saim"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#1C1416" BorderBrush="#3D2020" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,0">
                    <TextBlock Text="⚠ CleanSweep forcefully deletes temporary and prefetch files. By proceeding, you agree to use it at your own risk." 
                               Foreground="#FFB0B0" TextWrapping="Wrap" FontSize="11.5"/>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PAGE 2: Select Destination -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel x:Name="Page2_Location" Visibility="Collapsed">
                <TextBlock Text="Select Installation Folder" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentMintBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Choose where CleanSweep will be installed." Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,24"/>
                
                <TextBlock Text="Installation path:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" FontSize="12"/>
                
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPath" Text="C:\Program Files\CleanSweep" 
                             Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                             BorderBrush="#30363D" BorderThickness="1" Padding="10,8" 
                             VerticalContentAlignment="Center" FontSize="13"
                             CaretBrush="{StaticResource AccentMintBrush}"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource WizardButton}" Click="BrowseButton_Click"/>
                </Grid>
                
                <TextBlock Text="At least 200 MB of free disk space is required." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PAGE 3: Downloading & Installing -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel x:Name="Page3_Installing" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Downloading CleanSweep..." FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentMintBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Please wait while Setup downloads and installs CleanSweep." Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,24"/>
                
                <TextBlock x:Name="TxtStatus" Text="Connecting to server..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                
                <!-- Progress bar container with rounded corners -->
                <Border Background="#262A33" CornerRadius="4" Height="20" Margin="0,0,0,8">
                    <Grid>
                        <ProgressBar x:Name="ProgressBar" Height="20" Minimum="0" Maximum="100" Value="0" 
                                     Background="Transparent" Foreground="{StaticResource AccentMintBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtDownloadSize" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PAGE 4: Finished -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel x:Name="Page4_Finished" Visibility="Collapsed">
                <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Setup Complete!" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="CleanSweep has been successfully installed on your computer." 
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="13" Margin="0,0,0,30"/>
                
                <StackPanel HorizontalAlignment="Center">
                    <CheckBox x:Name="ChkCreateShortcut" IsChecked="False" Style="{StaticResource InstallerCheckBox}">
                        <TextBlock Text="Create a desktop shortcut" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkLaunchApp" IsChecked="False" Style="{StaticResource InstallerCheckBox}">
                        <TextBlock Text="Launch CleanSweep" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </CheckBox>
                </StackPanel>
            </StackPanel>

            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"/>

        <!-- Footer / Navigation -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" Padding="24,14">
            <Grid>
                <TextBlock Text="CleanSweep v1.0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="‹ Back" Style="{StaticResource WizardButton}" Click="BtnBack_Click" IsEnabled="False"/>
                    <Button x:Name="BtnNext" Content="Next ›" Style="{StaticResource PrimaryWizardButton}" Click="BtnNext_Click"/>
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WizardButton}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
